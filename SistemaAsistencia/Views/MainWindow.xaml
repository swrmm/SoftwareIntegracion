<Window x:Class="SistemaAsistencia.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaAsistencia.Views"
        xmlns:vm="clr-namespace:SistemaAsistencia.ViewModels"
        mc:Ignorable="d"
        Title="Control de Asistencia" Height="750" Width="1200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            
            <DataTemplate DataType="{x:Type vm:AsistenciaViewModel}">
                <local:AsistenciaView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReporteAtrasosViewModel}">
                <local:ReporteAtrasosView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReporteSalidasViewModel}">
                <local:ReporteSalidasView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReporteInasistenciasViewModel}">
                <local:ReporteInasistenciasView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GestionUsuariosViewModel}">
                <local:GestionUsuariosView/>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="MainWindowBorder" Background="{StaticResource BgDark}" CornerRadius="12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Title -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,24,20,24">
                        <TextBlock Text="🏢" FontSize="24" Margin="0,0,10,0"/>
                        <TextBlock Text="Control de&#x0a;Asistencia" Style="{StaticResource NormalText}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- User Info -->
                    <StackPanel Grid.Row="1" Margin="20,0,20,32">
                        <Border Width="60" Height="60" CornerRadius="30" Background="{StaticResource AccentGradient}" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="{Binding InicialUsuario}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding NombreUsuario}" Style="{StaticResource SubHeaderText}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding RolUsuarioText}" Style="{StaticResource SmallText}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Navigation Menu -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,20">
                            <Button Tag="asistencia" Command="{Binding NavegarCommand}" CommandParameter="asistencia">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MenuActivo}" Value="asistencia">
                                                <Setter Property="Background" Value="{StaticResource BgCard}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="📋  Marcar Asistencia"/>
                            </Button>

                            <StackPanel Visibility="{Binding EsAdmin, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="REPORTES" Style="{StaticResource SmallText}" Margin="20,20,20,8"/>
                                
                                <Button Tag="atrasos" Command="{Binding NavegarCommand}" CommandParameter="atrasos">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MenuActivo}" Value="atrasos">
                                                    <Setter Property="Background" Value="{StaticResource BgCard}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="📊  Atrasos"/>
                                </Button>

                                <Button Tag="salidas" Command="{Binding NavegarCommand}" CommandParameter="salidas">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MenuActivo}" Value="salidas">
                                                    <Setter Property="Background" Value="{StaticResource BgCard}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="🚪  Salidas Anticipadas"/>
                                </Button>

                                <Button Tag="inasistencias" Command="{Binding NavegarCommand}" CommandParameter="inasistencias">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MenuActivo}" Value="inasistencias">
                                                    <Setter Property="Background" Value="{StaticResource BgCard}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="❌  Inasistencias"/>
                                </Button>

                                <TextBlock Text="ADMINISTRACIÓN" Style="{StaticResource SmallText}" Margin="20,20,20,8"/>

                                <Button Tag="usuarios" Command="{Binding NavegarCommand}" CommandParameter="usuarios">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MenuActivo}" Value="usuarios">
                                                    <Setter Property="Background" Value="{StaticResource BgCard}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="👥  Gestión de Usuarios"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom -->
                    <Button Grid.Row="3" Command="{Binding CerrarSesionCommand}" Margin="0,0,0,20">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Setter Property="Foreground" Value="{StaticResource Error}"/>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="🔒  Cerrar Sesión"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Custom Title Bar -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                        <Button Style="{StaticResource IconButton}" Content="—" Width="30" Height="30" Click="MinimizeButton_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="□" Width="30" Height="30" Click="MaximizeButton_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="✕" Width="30" Height="30" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Dynamic Content -->
                <ContentControl Grid.Row="1" Content="{Binding VistaActual}" Margin="24"/>
            </Grid>
        </Grid>
    </Border>
</Window>
