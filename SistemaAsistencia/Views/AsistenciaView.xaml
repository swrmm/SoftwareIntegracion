<UserControl x:Class="SistemaAsistencia.Views.AsistenciaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SistemaAsistencia.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <!-- Clock -->
            <TextBlock Text="{Binding HoraActual}" FontSize="96" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#00d2ff" Offset="0.0"/>
                        <GradientStop Color="#7b2ff7" Offset="1.0"/>
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>
            
            <!-- Date -->
            <TextBlock Text="{Binding FechaActual}" Style="{StaticResource SubHeaderText}" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,40"/>
            
            <!-- Status Card -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,40" MinWidth="400">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="ℹ️" FontSize="20" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding EstadoHoy}" Style="{StaticResource SubHeaderText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                <!-- Entrada -->
                <Button Command="{Binding MarcarEntradaCommand}" IsEnabled="{Binding PuedeMarcarEntrada}" Width="220" Height="140" Margin="0,0,30,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Background" Value="{StaticResource Success}"/>
                            <Setter Property="Foreground" Value="{StaticResource BgDark}"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="{StaticResource BgLighter}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4de6c2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel>
                        <TextBlock Text="⏰" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Marcar Entrada" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Salida -->
                <Button Command="{Binding MarcarSalidaCommand}" IsEnabled="{Binding PuedeMarcarSalida}" Width="220" Height="140">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Background" Value="{StaticResource AccentPrimary}"/>
                            <Setter Property="Foreground" Value="{StaticResource BgDark}"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="{StaticResource BgLighter}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#33dbff"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel>
                        <TextBlock Text="🏠" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Marcar Salida" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            
            <!-- Status Message -->
            <TextBlock Text="{Binding MensajeEstado}" Foreground="{StaticResource Success}" HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubHeaderText}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensajeEstado}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MensajeEstado}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            
        </StackPanel>
    </Grid>
</UserControl>
